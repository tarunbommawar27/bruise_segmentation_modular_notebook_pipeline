labelbox_paul_orc_dataset_full_consensus/
labelbox_als_intersection/
labelbox_als_train/
ita_labels/
splits/
scripts/missing10_wl_skintone/
**/images/
**/masks/
**/masks_*/
**/masks_individual/
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp

# ---- Model weights / checkpoints / native run dirs ----
pretrained_weights/
segformer_b0_direct/
segformer_b0_distilled/
segformer_b2_teacher/
yolo_sem_direct/
yolo_sem_distilled/
runs_final/
runs_baselines/
